/*
 * Rofi config — pulls live colors from the current Omarchy theme.
 *
 * Colors are imported from ~/.config/omarchy/current/theme/rofi.rasi, which
 * is regenerated by `omarchy-theme-set-templates` from the .tpl source in
 * ~/.config/omarchy/themed/rofi.rasi.tpl on every theme change.
 */

configuration {
    modi:                "drun,calc,combi,window";
    combi-modes:         "window,drun,calc";
    show-icons:          true;
    drun-display-format: "{name}";
    display-combi:       "Search";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Win";
    display-calc:        "Calc";
    /* rofi-calc: copy the result on Enter */
    calc-command:        "echo -n '{result}' | wl-copy";
    terminal:            "ghostty";
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    case-sensitive:      false;
    cycle:               true;
    scroll-method:       0;

    /* rofi-calc options — show live results in the message widget */
    calc {
        terse:        true;        /* show "4" instead of "2+2 = 4" */
        hint-welcome: "Type an expression";
        hint-result:  "= ";
    }
}

@theme "~/.config/omarchy/current/theme/rofi.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-col;
    border-radius:    12px;
    width:            644px;
    padding:          12px;
    location:         center;
    anchor:           center;
}

mainbox {
    /* `message` is required for rofi-calc to display live results as you type */
    children: [ inputbar, message, listview ];
    spacing:  10px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          8px;
    padding:          6px 10px;
    background-color: transparent;
    border-radius:    8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @muted;
    text-color:        @fg;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;   /* always reserve space for `lines` rows */
    dynamic:      false;  /* don't resize while filtering */
    scrollbar:    false;
    spacing:      2px;
    cycle:        true;
}

element {
    padding:          6px 10px;
    border-radius:    6px;
    background-color: transparent;
    spacing:          8px;
}

element normal.normal,
element alternate.normal {
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @urgent;
}

element normal.active,
element alternate.active,
element selected.active {
    text-color: @active;
}

element selected {
    background-color: @sel-bg;
    text-color:       @sel-fg;
    border:           0 0 0 3px;
    border-color:     @accent;
}

element selected.urgent {
    background-color: @sel-bg;
    border-color:     @urgent;
}

element selected.active {
    background-color: @sel-bg;
    border-color:     @active;
}

element-icon {
    background-color: transparent;
    size:             20px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

/* Used by rofi -dmenu invocations (power, theme, share menus). */
error-message {
    background-color: @bg;
    text-color:       @urgent;
    padding:          12px;
    border-radius:    8px;
}

message {
    background-color: @bg-alt;
    text-color:       @accent;
    padding:          8px 12px;
    border-radius:    6px;
}

textbox {
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
}
