// Look and feel — ported from looknfeel.conf

layout {
    // niri gaps are uniform
    gaps 4

    default-column-width { proportion 0.5; }

    // A single column on a workspace stays centered
    always-center-single-column

    // Widths cycled by switch-preset-column-width (Mod+P): 33 / 50 / 67 / 100%
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    center-focused-column "never"

    // Border replaces the focus ring 
    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#c6d0f5ba"
        inactive-color "#595959aa"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 8
        spread 3
        offset x=0 y=3
        color "#1a1a1aee"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 4
        active-color "#c6d0f5ba"
        inactive-color "#595959aa"
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

blur {
    passes 2
    offset 2
    noise 0.02
    saturation 1.2
}

// REMOVED: blanket window-rule blur — it made everything unreadable on this setup.
// If you later want frosted Noctalia surfaces (bar/launcher/dock) only, add:
//
// layer-rule {
//     match namespace="^noctalia"
//     background-effect {
//         xray false
//     }
// }

// Animations: niri defaults are already fast; hyprland's `quick` bezier
// (workspaces fade) has no 1:1 mapping — tweak `animations {}` here if wanted.
animations {
    // slowdown 1.0
}
