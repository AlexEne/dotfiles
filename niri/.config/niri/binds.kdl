// Keybindings — ported from bindings.conf, tiling.conf, media.conf,
// clipboard.conf, utilities.conf
//
// "Mod" = Super (when running on a TTY). Dropped bindings that have no niri
// equivalent are listed at the bottom of this file.
//
// hotkey-overlay-title = the label shown in the Super+K cheat sheet.
// (Untitled spawn binds show up there with no description.)

binds {
    // === Applications (bindings.conf) ===
    Mod+Return hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+Shift+E hotkey-overlay-title="File Manager: nautilus" { spawn "nautilus" "--new-window"; }  // File manager
    Mod+Shift+B hotkey-overlay-title="Browser: Firefox" { spawn "firefox"; }                        // Browser
    Mod+Shift+Z allow-when-locked=true hotkey-overlay-title="Toggle Mic Mute (global)" { spawn "noctalia" "msg" "mic-mute"; }  // Global mic mute (Noctalia)
    Mod+Shift+N hotkey-overlay-title="Editor: nvim" { spawn "ghostty" "-e" "nvim"; }                // Editor (nvim)
    Mod+Shift+T hotkey-overlay-title="System Monitor: btop" { spawn "ghostty" "-e" "btop"; }        // System monitor

    // Center active window (tiling)
    Mod+Shift+C { center-column; }

    // Wallpaper picker (Noctalia panel)
    Mod+Ctrl+Space hotkey-overlay-title="Wallpaper Picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }

    // Screenshot area with editing (saved to ~/Pictures)
    Mod+Shift+S hotkey-overlay-title="Screenshot: region + edit" { spawn-sh "~/.config/niri/scripts/screenshot.sh"; }

    // Wayscriber 
    Mod+D hotkey-overlay-title="Wayscriber" { spawn "wayscriber" "--active"; }

    // Lock screen 
    Mod+Ctrl+L allow-inhibiting=false hotkey-overlay-title="Lock Screen" { spawn "noctalia" "msg" "session" "lock"; }

    // === Window/session control (tiling.conf) ===
    Mod+W repeat=false { close-window; }                    // Close focused window
    Ctrl+Alt+Delete hotkey-overlay-title="Close ALL Windows" { spawn-sh "~/.config/niri/scripts/close-all-windows.sh"; }  // Close ALL windows

    Mod+T { toggle-window-floating; }                       // Float ↔ tile
    Mod+F { fullscreen-window; }                            // True fullscreen
    Mod+Ctrl+F { toggle-windowed-fullscreen; }   // was fullscreenstate 0 2 — fake fullscreen, keeps its tile
    Mod+Alt+F { maximize-window-to-edges; }      // was fullscreen 1 (true maximize)
    Mod+P { switch-preset-column-width; }        // cycle 33% / 50% / 67% / 100%
    Mod+O repeat=false hotkey-overlay-title="Pop Out Window (float 1300x900)" { spawn-sh "~/.config/niri/scripts/window-pop.sh"; }  // custom: scripts/window-pop.sh
    Mod+Shift+O repeat=false { toggle-overview; }           // Zoomed-out overview of all workspaces

    // Move focus with SUPER + arrow keys
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Switch workspaces: SUPER + 1..9, 0 (hyprland code:10–19)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Move window to workspace: SUPER + SHIFT + 1..9, 0 (follows, like movetoworkspace)
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // Move window silently (stay on current workspace): SUPER + SHIFT + ALT + 1..9, 0
    Mod+Shift+Alt+1 { move-window-to-workspace 1 focus=false; }
    Mod+Shift+Alt+2 { move-window-to-workspace 2 focus=false; }
    Mod+Shift+Alt+3 { move-window-to-workspace 3 focus=false; }
    Mod+Shift+Alt+4 { move-window-to-workspace 4 focus=false; }
    Mod+Shift+Alt+5 { move-window-to-workspace 5 focus=false; }
    Mod+Shift+Alt+6 { move-window-to-workspace 6 focus=false; }
    Mod+Shift+Alt+7 { move-window-to-workspace 7 focus=false; }
    Mod+Shift+Alt+8 { move-window-to-workspace 8 focus=false; }
    Mod+Shift+Alt+9 { move-window-to-workspace 9 focus=false; }
    Mod+Shift+Alt+0 { move-window-to-workspace 10 focus=false; }

    Mod+S { focus-workspace "scratchpad"; }
    Mod+Alt+S { move-window-to-workspace "scratchpad" focus=false; }

    // TAB between workspaces
    Mod+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Ctrl+Tab { focus-workspace-previous; }

    // Move workspaces to other monitors
    Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }

    // Swap windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Cycle through applications → Noctalia window switcher
    Alt+Tab       hotkey-overlay-title="Window Switcher" { spawn "noctalia" "msg" "window-switcher"; }
    Alt+Shift+Tab hotkey-overlay-title="Window Switcher" { spawn "noctalia" "msg" "window-switcher"; }

    // Resize active window (SUPER + -/=, heights with SHIFT)
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Scroll through workspaces with SUPER + scroll
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Groups → tabbed columns
    Mod+G { toggle-column-tabbed-display; }
    Mod+J { toggle-column-tabbed-display; }      // was togglesplit — same habit key
    Mod+Alt+G { expel-window-from-column; }      // was moveoutofgroup
    Mod+Alt+Left  { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }
    Mod+Alt+Up    { consume-window-into-column; }
    Mod+Alt+Down  { expel-window-from-column; }

    // Keyboard layout switching sits where the dwindle↔scrolling toggle used to
    // be (no-op with a single "us" layout; add layouts in input.kdl to use it)
    Mod+L { switch-layout "next"; }

    // Navigate windows inside a column (was: changegroupactive)
    Mod+Alt+Tab       { focus-window-down; }
    Mod+Alt+Shift+Tab { focus-window-up; }
    Mod+Ctrl+Left     { focus-window-up; }
    Mod+Ctrl+Right    { focus-window-down; }
    Mod+Alt+WheelScrollDown { focus-window-down; }
    Mod+Alt+WheelScrollUp   { focus-window-up; }

    // === Media keys with OSD (media.conf) ===
    XF86AudioRaiseVolume  allow-when-locked=true hotkey-overlay-title="Volume Up" { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume  allow-when-locked=true hotkey-overlay-title="Volume Down" { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute         allow-when-locked=true hotkey-overlay-title="Mute Volume" { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute      allow-when-locked=true hotkey-overlay-title="Mute Microphone" { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Brightness Up" { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Down" { spawn "swayosd-client" "--brightness" "lower"; }

    // ALT + media key = fine-grained 1% steps
    Alt+XF86AudioRaiseVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "+1"; }
    Alt+XF86AudioLowerVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "-1"; }
    Alt+XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "+1"; }
    Alt+XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "-1"; }

    XF86AudioNext  allow-when-locked=true hotkey-overlay-title="Next Track" { spawn "swayosd-client" "--playerctl" "next"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Play / Pause" { spawn "swayosd-client" "--playerctl" "play-pause"; }
    XF86AudioPlay  allow-when-locked=true hotkey-overlay-title="Play / Pause" { spawn "swayosd-client" "--playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true hotkey-overlay-title="Previous Track" { spawn "swayosd-client" "--playerctl" "previous"; }

    // Switch default audio output (SUPER + hardware mute key)
    Mod+XF86AudioMute allow-when-locked=true hotkey-overlay-title="Switch Audio Output" { spawn-sh "~/.config/niri/scripts/audio-switch.sh"; }

    // === Clipboard (clipboard.conf) ===
    // niri has no sendshortcut → wtype injects the key events instead
    Mod+C hotkey-overlay-title="Copy (Ctrl+Insert)" { spawn-sh "wtype -M ctrl -k Insert -m ctrl"; }       // Copy (Ctrl+Insert)
    Mod+V hotkey-overlay-title="Paste (Shift+Insert)" { spawn-sh "wtype -M shift -k Insert -m shift"; }   // Paste (Shift+Insert)
    Mod+X hotkey-overlay-title="Cut (Ctrl+X)" { spawn-sh "wtype -M ctrl -k x -m ctrl"; }                  // Cut (Ctrl+X)
    Mod+Ctrl+V hotkey-overlay-title="Clipboard History (walker)" { spawn "walker" "-m" "clipboard" "--width" "644" "--maxheight" "300" "--minheight" "300"; }  // Clipboard history (walker)

    // === Menus & utilities (utilities.conf) ===
    Mod+Space hotkey-overlay-title="App Launcher (rofi)" { spawn-sh "pkill -x rofi || rofi -show drun"; }   // App launcher (rofi; press again to close)
    Mod+Alt+Space hotkey-overlay-title="App Launcher (walker)" { spawn "walker"; }                          // App launcher (walker)
    Mod+Ctrl+E hotkey-overlay-title="Emoji Picker" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }  // Emoji picker (Noctalia launcher)
    Mod+Escape hotkey-overlay-title="Power Menu" { spawn-sh "~/.config/niri/scripts/power-menu.sh"; }       // Power menu
    XF86PowerOff allow-when-locked=true hotkey-overlay-title="Power Menu" { spawn-sh "~/.config/niri/scripts/power-menu.sh"; }  // Power menu (hardware key)
    Mod+K { show-hotkey-overlay; }                          // Hotkey cheat sheet (this overlay)
    XF86Calculator hotkey-overlay-title="Calculator" { spawn "gnome-calculator" "--mode=programming"; }     // Calculator

    // Aesthetics
    Mod+Shift+Space hotkey-overlay-title="Toggle Bar" { spawn "noctalia" "msg" "bar-toggle"; }   // Toggle bar (Noctalia) — was toggle-waybar.sh
    Mod+Shift+Ctrl+Space hotkey-overlay-title="Theme Menu" { spawn-sh "~/.config/niri/scripts/theme-menu.sh"; }  // Theme switcher menu
    Mod+BackSpace { toggle-window-rule-opacity; }   // was setprop opaque toggle —
    // note: only has a visible effect if you add window rules with opacity < 1
    // SUPER+SHIFT+BACKSPACE toggle-gaps dropped (niri gaps are config-only)

    // Notifications (mako)
    Mod+Comma hotkey-overlay-title="Dismiss Notification" { spawn "makoctl" "dismiss"; }                // Dismiss top notification
    Mod+Shift+Comma hotkey-overlay-title="Dismiss All Notifications" { spawn "makoctl" "dismiss" "--all"; }  // Dismiss all notifications
    Mod+Ctrl+Comma hotkey-overlay-title="Toggle Do Not Disturb" { spawn-sh "makoctl mode -t do-not-disturb && makoctl mode | grep -q 'do-not-disturb' && notify-send 'Silenced notifications' || notify-send 'Enabled notifications'"; }  // Toggle do-not-disturb
    Mod+Alt+Comma hotkey-overlay-title="Trigger Notification Action" { spawn "makoctl" "invoke"; }      // Trigger notification's default action
    Mod+Shift+Alt+Comma hotkey-overlay-title="Restore Dismissed Notification" { spawn "makoctl" "restore"; }  // Restore last dismissed

    // Toggle idling (Noctalia caffeine / idle inhibitor)
    Mod+Ctrl+I hotkey-overlay-title="Toggle Idle Inhibitor (caffeine)" { spawn "noctalia" "msg" "caffeine-toggle"; }

    // === Captures ===
    // Print: select a region, edit in satty (hyprland's click-a-window PRINT was
    // hyprctl-based; region select is the portable equivalent)
    Print hotkey-overlay-title="Screenshot: region → annotate (satty)" { spawn-sh "grim -g \"$(slurp)\" - | satty --filename -"; }   // Region → annotate in satty
    Shift+Print hotkey-overlay-title="Screenshot: region → clipboard" { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }        // Region → clipboard
    Alt+Print hotkey-overlay-title="Screen Recording: start (with audio)" { spawn-sh "wf-recorder -a -f \"$(xdg-user-dir VIDEOS)/recording-$(date +%Y%m%d-%H%M%S).mp4\" & notify-send 'Screen Recording' 'Started'"; }  // Screen recording (with audio)
    Mod+Print hotkey-overlay-title="Color Picker (hyprpicker)" { spawn "hyprpicker" "-a"; }   // Live preview picker, copies #hex

    // File sharing
    Mod+Ctrl+S hotkey-overlay-title="Share File" { spawn-sh "rofi -dmenu -i -p \"Share\" -theme-str \"window { width: 380px; } listview { lines: 6; }\""; }

    // Information
    Mod+Ctrl+Alt+T hotkey-overlay-title="Show Date & Time" { spawn-sh "notify-send \" $(date +'%A %H:%M  —  %d %B W%V %Y')\""; }
    Mod+Ctrl+Alt+B hotkey-overlay-title="Show Battery Level" { spawn-sh "notify-send \" Battery at $(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null || echo 'N/A')%\""; }

    // Control panels
    Mod+Ctrl+A hotkey-overlay-title="Audio Mixer (wiremix)" { spawn "ghostty" "-e" "wiremix"; }           // Audio mixer
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth Manager (bluetui)" { spawn-sh "rfkill unblock bluetooth; ghostty -e bluetui"; }  // Bluetooth manager
    Mod+Ctrl+W hotkey-overlay-title="Wi-Fi Manager (impala)" { spawn-sh "rfkill unblock wifi; ghostty -e impala"; }             // Wi-Fi manager
    Mod+Ctrl+T hotkey-overlay-title="System Monitor: btop" { spawn "ghostty" "-e" "btop"; }               // System monitor

    // Escape hatch: never let an app (VM, remote desktop) swallow this one
    Mod+Alt+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
