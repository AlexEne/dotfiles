# Leader-key setup. ⌘+Esc enters "apps" mode; next key picks an app, then auto-returns to default.
# `apps` auto-exits after 1s of inactivity via a token-guarded background escape.
# The default mode's entry command clears the token, so any transition back to default
# (app pick, explicit escape, or the timer itself) suppresses a stale escape keypress.
:: default : rm -f /tmp/skhd_apps_token
:: apps @ : TOKEN=$$; echo "$TOKEN" > /tmp/skhd_apps_token; \
            (sleep 1; [ "$(cat /tmp/skhd_apps_token 2>/dev/null)" = "$TOKEN" ] \
             && /opt/homebrew/bin/skhd -k "escape") &

default < cmd - escape ; apps
	
apps < s : open -b com.tinyspeck.slackmacgap && /opt/homebrew/bin/skhd -k "escape"
apps < m : open -b com.microsoft.Outlook     &&  /opt/homebrew/bin/skhd-k "escape"
apps < t : open -b com.mitchellh.ghostty   && /opt/homebrew/bin/skhd -k "escape"
apps < v : open -b com.cisco.secureclient.gui && /opt/homebrew/bin/skhd -k "escape"
apps < w : open -b org.mozilla.firefox && /opt/homebrew/bin/skhd -k "escape"
apps < z : open -b us.zoom.xos               && /opt/homebrew/bin/skhd -k "escape"
apps < e : open -b dev.zed.Zed        && /opt/homebrew/bin/skhd -k "escape"
	
# Escape from leader mode
apps < escape ; default
