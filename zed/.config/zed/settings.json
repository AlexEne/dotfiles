// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "dap": {
    "CodeLLDB": {
      "binary": "/home/alex/Work/codelldb/build/adapter/codelldb",
      "env": { "RUST_LOG": "debug" },
    },
  },
  "debugger": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diff_view_style": "split",
  "language_models": {
    "opencode": {
      "show_zen_models": true,
      "show_go_models": false,
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "button": false,
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "none",
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "colorize_brackets": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "button": false,
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "enable_thinking": false,
      "provider": "opencode",
      "model": "zen/gpt-5.4",
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rust": {
          "analyzerTargetDir": true,
          "checkOnSave": true,
        },
      },
    },
  },
